---
layout: base.njk
---
<div class="wrap" style="padding-top: 70px;">
  <h1 class="case-title">{{ title }}</h1>
  <span class="case-context">{{ context }}</span>
  <div class="read-time">{{ content | readingTime }} min read</div>

  <div class="stat-strip">
    {% for stat in stats %}
    <div>
      <div class="stat-num">{{ stat.n }}</div>
      <div class="stat-label">{{ stat.label }}</div>
    </div>
    {% endfor %}
  </div>

  {% if tldr %}
  <div class="tldr">
    <span class="tldr-tag">TL;DR</span>
    <p>{{ tldr }}</p>
  </div>
  {% endif %}

  <div class="case-body">
    {{ content | safe }}
  </div>

  <div class="case-cta">
    <strong>Facing something similar?</strong> I'm happy to compare notes. <a href="mailto:hello@pragmaticagents.dev">hello@pragmaticagents.dev</a> · <a href="https://www.linkedin.com/in/santhoshba/" target="_blank" rel="noopener">LinkedIn ↗</a>
  </div>
</div>
